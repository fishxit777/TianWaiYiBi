# 請複製概念到你的啟動環境，不要把真實值提交到版本控制。
APP_SECRET_KEY=replace-with-at-least-32-random-bytes
APP_ENV=development
COOKIE_SECURE=false
DATABASE_PATH=
# 正式環境使用 PostgreSQL；只可存於 Render／GitHub Secret，不可貼進檔案或命令列。
DATABASE_URL=
ADMIN_USERNAME=keeper
# 正式環境優先使用 scripts/generate_admin_credential.py 產生的 Argon2id 值。
ADMIN_PASSWORD_HASH=
# 僅供尚未輪替或本機臨時環境相容；正式設定 Hash 後請移除。
ADMIN_PASSWORD=replace-with-a-temporary-long-unique-password
ADMIN_SESSION_BIND_IP=true
ADMIN_IP_ALLOWLIST_REQUIRED=false
ADMIN_ALLOWED_IPS=
# 只在 Argon2id 密碼、10 組離線復原碼與 Turnstile 都完成後啟用。
ADMIN_RECOVERY_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

PAYMENT_WEBHOOK_SECRET=replace-with-a-payment-webhook-secret
PAYMENT_PROVIDER=mock
ECPAY_MODE=stage
ECPAY_LIVE_CONFIRMED=false
ECPAY_VERIFICATION_ENABLED=false
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_STORE_ID=TWYB
PAYMENT_VERIFICATION_EMAIL=

# 付款後交付信與 10 分鐘登入／開通碼。正式收款前必須完成並實測。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# 只填天外一筆管理員本人的 Gmail／Email，不得使用客戶地址。
ADMIN_ALERT_EMAIL=
# 與 GitHub Actions Secret 同值，至少 32 字元；不得與管理密碼或其他專案共用。
NOTIFICATION_CRON_SECRET=replace-with-a-unique-32-character-or-longer-secret
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 只填天外一筆管理員本人的 LINE userId；不得沿用其他專案收件人。
LINE_ADMIN_USER_ID=

ENABLE_DEV_TOOLS=true
BASE_URL=http://127.0.0.1:5088
PORT=5088
TRUST_PROXY=false
