# 請複製概念到你的啟動環境，不要把真實值提交到版本控制。
APP_SECRET_KEY=replace-with-at-least-32-random-bytes
APP_ENV=development
COOKIE_SECURE=false
DATABASE_PATH=
ADMIN_USERNAME=keeper
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_BIND_IP=true
ADMIN_IP_ALLOWLIST_REQUIRED=false
ADMIN_ALLOWED_IPS=

PAYMENT_WEBHOOK_SECRET=replace-with-a-payment-webhook-secret
PAYMENT_PROVIDER=mock
ECPAY_MODE=stage
ECPAY_LIVE_CONFIRMED=false
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# 付款後交付信與 7 分鐘登入碼。正式收款前必須完成並實測。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

ENABLE_DEV_TOOLS=true
BASE_URL=http://127.0.0.1:5088
PORT=5088
TRUST_PROXY=false
